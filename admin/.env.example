# ==============================================================================
# JokiTugasKu v2 — Admin Hub Environment Configuration
# ==============================================================================

# Supabase Database & Auth (Get from your Supabase Project Settings > API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Production Domain URLs
VITE_PUBLIC_URL=https://jokitugasku.id
VITE_ADMIN_URL=https://admin.jokitugasku.id

# Demo Mode (Set to 'false' in production so quick login buttons remain hidden)
VITE_DEMO_MODE=false
